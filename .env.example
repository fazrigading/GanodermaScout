# Environment Configuration Example for GanodermaScout

# --- Application Ports ---
GATEWAY_PORT=8000
CORE_API_PORT=8001
VISION_PORT=8002
AGENTS_PORT=8003
WEB_PORT=3000
N8N_PORT=5678
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- PostgreSQL & pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ganodermascout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ganodermascout
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres@postgres:5432/ganodermascout

# --- Redis 7 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=stream:inspection_jobs
REDIS_DLQ_KEY=stream:inspection_dlq

# --- Storage Layer ---
# STORAGE_BACKEND: "local" (default, uses a Docker volume) or "s3" (S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage

# S3-compatible backend settings (used when STORAGE_BACKEND=s3)
# Works with SeaweedFS (docker compose --profile s3 up), Garage, AWS S3, or any S3-compatible bucket.
S3_ENDPOINT=
S3_BUCKET=ganodermascout-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=false

# SeaweedFS port (only relevant when using the s3 profile)
S3_PORT=8333

# --- LLM & Embedding Settings (Dual-Mode: Cloud vs Local) ---
# LLM_PROVIDER: "openai", "anthropic", "gemini", "ollama", or "vllm"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# EMBEDDING_PROVIDER: "openai" or "huggingface"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VISION_SERVICE_URL=http://localhost:8002
VISION_MODEL_NAME=yolov12

# --- Security & Auth ---
JWT_SECRET=dev-jwt-secret-key-change-in-production-min32chars
WEBHOOK_SECRET=dev-webhook-hmac-secret-key-min32chars
